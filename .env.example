# ---------------------------------------------------------------------------
# Coding Challenge 2026 — environment template
# Copy to .env for local development. NEVER commit a filled-in .env.
# Every value below is a placeholder; no real credential belongs in this file.
# ---------------------------------------------------------------------------

# --- Server-only secrets (never expose to the browser, never prefix VITE_) ---

# Signing key for the platform's own session cookie (JWT, HS256).
# Use a random string of 32+ characters.
APP_SESSION_SECRET=

# Competition Postgres/Supabase project that stores all competition data.
# Either provide the project URL directly...
OWN_SUPABASE_URL=
# ...or the pooled connection string it can be derived from.
OWN_SUPABASE_DB_URL=
# Service-role key for that project. Server-side only, full database access.
OWN_SUPABASE_SERVICE_ROLE_KEY=

# Bootstrap credentials for the administrator account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Password assigned to students created through self-registration.
DEFAULT_STUDENT_PASSWORD=

# Piston execution nodes used ONLY by the CodeArena backend (never the browser).
# The pool is stored in the database and managed under Admin -> Infrastructure;
# this variable only seeds it the first time the tables are created.
PISTON_NODES_JSON=[{"id":"piston-vm-1","url":"http://148.113.52.23:8080","enabled":true,"maxConcurrentJobs":20},{"id":"piston-vm-2","url":"http://148.113.52.28:8080","enabled":true,"maxConcurrentJobs":20},{"id":"piston-vm-3","url":"http://148.113.52.24:8080","enabled":true,"maxConcurrentJobs":20},{"id":"piston-vm-4","url":"http://148.113.52.39:8080","enabled":true,"maxConcurrentJobs":20}]

# Optional single-engine legacy endpoint (only used by the old Piston/Judge0
# engine list under Admin -> Execution engines).
PISTON_BASE_URL=


# --- Platform-managed backend (injected automatically in Lovable Cloud) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Browser-visible values (PUBLIC — anything here ships in the JS bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
